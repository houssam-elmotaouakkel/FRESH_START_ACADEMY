# Database
DATABASE_URL="mysql://app:app@localhost:3306/fresh_start_academy"

# JWT
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Email (Resend HTTP API — https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Fresh Start Academy <onboarding@resend.dev>"
CONTACT_EMAIL="freshstartacademy12@gmail.com"

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH="./uploads"
