generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  email          String         @unique(map: "email") @db.VarChar(255)
  password       String         @db.VarChar(255)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  phone          String?        @db.VarChar(20)
  avatar         String?        @db.VarChar(255)
  role           Role?          @default(STUDENT)
  isActive       Boolean?       @default(true) @map("is_active")
  isVerified     Boolean?       @default(false) @map("is_verified")
  totpSecret     String?        @map("totp_secret") @db.VarChar(255)
  totpEnabled    Boolean?       @default(false) @map("totp_enabled")
  lastLogin      DateTime?      @map("last_login") @db.DateTime(0)
  createdAt      DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime?      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  teacherCourses Course[]       @relation("TeacherCourses")
  enrollments    Enrollment[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]
  notifications  Notification[]
  payments       Payment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  token     String    @unique(map: "token") @db.VarChar(500)
  userId    String    @map("user_id") @db.VarChar(36)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("refresh_tokens")
}

model Course {
  id          String         @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  title       String         @db.VarChar(255)
  slug        String         @unique(map: "slug") @db.VarChar(255)
  description String         @db.Text
  content     String?        @db.LongText
  category    CourseCategory
  level       CourseLevel?   @default(BEGINNER)
  price       Decimal        @db.Decimal(10, 2)
  duration    Int
  maxStudents Int?           @default(20) @map("max_students")
  image       String?        @db.VarChar(255)
  isOnline    Boolean?       @default(true) @map("is_online")
  isActive    Boolean?       @default(true) @map("is_active")
  startDate   DateTime?      @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  teacherId   String?        @map("teacher_id") @db.VarChar(36)
  createdAt   DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime?      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  teacher     User?          @relation("TeacherCourses", fields: [teacherId], references: [id], onUpdate: NoAction, map: "courses_ibfk_1")
  enrollments Enrollment[]

  @@index([teacherId], map: "teacher_id")
  @@index([category], map: "idx_course_category")
  @@index([level], map: "idx_course_level")
  @@index([isActive], map: "idx_course_active")
  @@map("courses")
}

model Enrollment {
  id          String            @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId      String            @map("user_id") @db.VarChar(36)
  courseId    String            @map("course_id") @db.VarChar(36)
  status      EnrollmentStatus? @default(PENDING)
  enrolledAt  DateTime?         @default(now()) @map("enrolled_at") @db.DateTime(0)
  completedAt DateTime?         @map("completed_at") @db.DateTime(0)
  notes       String?           @db.Text
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "enrollments_ibfk_1")
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "enrollments_ibfk_2")

  @@unique([userId, courseId], map: "unique_enrollment")
  @@index([courseId], map: "course_id")
  @@map("enrollments")
}

model Testimonial {
  id         String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  author     String    @db.VarChar(100)
  role       String    @db.VarChar(50)
  content    String    @db.Text
  rating     Int?      @default(5)
  avatar     String?   @db.VarChar(255)
  isApproved Boolean?  @default(false) @map("is_approved")
  isFeatured Boolean?  @default(false) @map("is_featured")
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([isApproved], map: "idx_testimonial_approved")
  @@index([isFeatured], map: "idx_testimonial_featured")
  @@map("testimonials")
}

model Contact {
  id        String         @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name      String         @db.VarChar(100)
  email     String         @db.VarChar(255)
  phone     String?        @db.VarChar(20)
  subject   String?        @db.VarChar(255)
  message   String         @db.Text
  status    ContactStatus? @default(UNREAD)
  repliedAt DateTime?      @map("replied_at") @db.DateTime(0)
  createdAt DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime?      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status], map: "idx_contact_status")
  @@map("contacts")
}

model Setting {
  id        String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  key       String    @unique(map: "setting_key") @map("setting_key") @db.VarChar(100)
  value     String    @map("setting_value") @db.Text
  type      String?   @default("string") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("settings")
}

model AuditLog {
  id         String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId     String?   @map("user_id") @db.VarChar(36)
  action     String    @db.VarChar(100)
  resource   String    @db.VarChar(100)
  resourceId String?   @map("resource_id") @db.VarChar(36)
  details    String?   @db.Text
  ip         String?   @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "idx_audit_user")
  @@index([action], map: "idx_audit_action")
  @@index([resource], map: "idx_audit_resource")
  @@index([createdAt], map: "idx_audit_date")
  @@map("audit_logs")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  used      Boolean?  @default(false)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_reset_user")
  @@index([expiresAt], map: "idx_reset_expiry")
  @@map("password_resets")
}

model Notification {
  id        String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  data      String?   @db.Text
  isRead    Boolean?  @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_notif_user")
  @@index([isRead], map: "idx_notif_read")
  @@index([createdAt], map: "idx_notif_date")
  @@map("notifications")
}

model Payment {
  id            String         @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId        String         @map("user_id") @db.VarChar(36)
  courseId       String         @map("course_id") @db.VarChar(36)
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("MAD") @db.VarChar(10)
  status        PaymentStatus? @default(PENDING)
  method        String?        @db.VarChar(50)
  transactionId String?        @unique @map("transaction_id") @db.VarChar(255)
  paidAt        DateTime?      @map("paid_at") @db.DateTime(0)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_payment_user")
  @@index([status], map: "idx_payment_status")
  @@map("payments")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseCategory {
  LANGUAGES
  SUPPORT
  TRAINING
  SOFT_SKILLS
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
